# Server
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/certiflow?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="certiflow-super-secret-key-change-in-production"
JWT_EXPIRES_IN="24h"

# WhatsApp Mock Server
WHATSAPP_API_URL="http://localhost:3001/api/send"

# SLA
SLA_HOURS=48

# Quality threshold (batches with candidateCount >= this go through quality review)
QUALITY_THRESHOLD=50

# District quorum (number of district officer approvals needed)
DISTRICT_QUORUM=2

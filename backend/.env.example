# Server
PORT=3000

# Database
DATABASE_URL="postgresql://certiflow:certiflow123@localhost:5432/certiflow?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="replace-this-local-demo-secret"
JWT_EXPIRES_IN="24h"
DEMO_MODE=true
COOKIE_SECURE=false
